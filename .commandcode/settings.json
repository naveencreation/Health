      "Shell(node -e \"const p=require('./package.json'); console.log('reanimated:', p.dependencies['react-native-reanimated'], '| worklets:', p.dependencies['react-native-worklets']);\")",
      "Shell(npx expo-doctor)",
      "Shell(npx expo install react-native-worklets)"
