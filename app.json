{
  "expo": {
    "name": "calori",
    "slug": "calori",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calorify.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.calorify.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "owner": "naveen0004",
    "extra": {
      "eas": {
        "projectId": "b9a9bbaf-deb3-4e7b-bd12-3a8425fd7083"
      }
    }
  }
}
