rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserDoc(userId) {
      let data = request.resource.data;
      return (!('id' in data) || data.id == userId) &&
        (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
        (!('email' in data) || (data.email is string && data.email.size() > 3)) &&
        (!('goals' in data) || data.goals is map);
    }

    function isValidDailyLogDoc() {
      let data = request.resource.data;
      return (!('date' in data) || data.date is string) &&
        (!('waterMl' in data) || data.waterMl is number) &&
        (!('steps' in data) || data.steps is number) &&
        (!('meals' in data) || data.meals is list) &&
        (!('activities' in data) || data.activities is list);
    }

    // Match Root Collection: users
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserDoc(userId);
      allow delete: if isOwner(userId);

      // Match Subcollection: dailyLogs
      match /dailyLogs/{date} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDailyLogDoc();
        allow delete: if isOwner(userId);
      }

      // Match Subcollection: customFoods (User-Scoped Custom Food Library)
      match /customFoods/{foodId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default Deny Rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
