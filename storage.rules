rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. Strict Default Deny: No public access anywhere
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // 2. User-Scoped Meal Photos
    // Strictly isolates photos per authenticated user UID.
    // User A (uid_123) CANNOT read, write, or delete User B's (uid_456) files.
    match /users/{userId}/meals/{mealId} {
      // Allow read only to the account owner
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow upload only by the account owner with strict size & MIME checks
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size < 1 * 1024 * 1024 // 1 MB max (compressed photos are ~100 KB)
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      // Allow delete only by the account owner
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 3. User-Scoped Avatars
    match /users/{userId}/avatars/{avatarId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size < 1 * 1024 * 1024 // 1 MB max
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
